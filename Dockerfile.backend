# syntax=docker/dockerfile:1
#
# Builds the Medusa backend (apps/backend) out of the pnpm/turbo monorepo
# for Railway. Only the backend workspace is deployed here - the Nuxt/Next
# storefront is not part of this image and deploys separately (Vercel).
#
# The same image is used for both the API server and the background worker
# Railway service; which one a container runs is controlled entirely by the
# WORKER_MODE env var (shared | server | worker), read by medusa-config.ts.

FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@11.5.0 --activate
WORKDIR /repo

# ---- Build stage: needs the full monorepo (pnpm workspace resolution
# requires every workspace's package.json + the root lockfile), plus
# devDependencies to compile TypeScript and bundle the Admin dashboard.
FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter=@dtc/backend build

# ---- Production stage.
#
# `apps/backend/.medusa/server` is Medusa's own documented production
# artifact (compiled src, compiled medusa-config.js, built Admin static
# assets) - see https://docs.medusajs.com/learn/production. Medusa's own
# docs have you `cd .medusa/server && npm install` there, a fresh,
# lockfile-less install. That reliably reproduces a real bug: with no
# lockfile to pin it, that install resolves whatever patch version of
# each dependency is newest *today*, not what the rest of the monorepo
# was built and tested against. Concretely, this repo's own lockfile
# pins @mikro-orm/migrations to 6.6.1, but the standalone install kept
# resolving 6.6.12 - and 6.6.12 hangs forever partway through
# `medusa db:migrate` on a fresh database (confirmed by diffing resolved
# versions between a working native run and a hanging containerized one,
# with every other package - @mikro-orm/core, knex, pg - matching
# exactly). Pinning that one package as a workaround (via
# pnpm-workspace.yaml's `overrides`) was not enough by itself to trust
# this path for every other transitive dependency too.
#
# So instead of a second, independent install, this stage reuses the
# monorepo's own already-installed, lockfile-verified node_modules
# as-is. pnpm's node_modules are a symlink farm (each workspace's
# node_modules/<pkg> is a *relative* symlink into the shared
# node_modules/.pnpm store) - copying both directories with the same
# relative layout preserves those symlinks correctly. .medusa/server
# has no node_modules of its own, so Node's normal upward module
# resolution from its compiled files finds everything in
# apps/backend/node_modules instead, with the exact versions actually
# built and tested against.
FROM base AS production
ENV NODE_ENV=production
WORKDIR /repo
# One COPY, not three separate `COPY --from=build` instructions for
# node_modules / apps/backend/node_modules / apps/backend/.medusa/server
# individually. The split version reliably failed on Railway's remote
# builder specifically (works fine with a plain local `docker build`) -
# "failed to calculate checksum of ref ...: not found" for one of the
# paths, reproducible even with the service's NO_CACHE=1 set, so it
# wasn't stale/evicted cache. A single COPY of the whole stage removes
# any question of the builder mishandling multiple references into the
# same source stage. Larger image (carries the storefront workspace's
# own node_modules too, and backend's devDependencies) but correct and
# reliable beats lean and fragile here.
COPY --from=build /repo /repo
WORKDIR /repo/apps/backend/.medusa/server

EXPOSE 9000

# Not `node_modules/.bin/medusa` - that's a shell-script wrapper (fails
# under a plain `node <path>` invocation); this is the actual JS
# entrypoint it wraps.
CMD ["node", "../../node_modules/@medusajs/cli/cli.js", "start"]
