# syntax=docker/dockerfile:1
#
# Builds the Medusa backend (apps/backend) out of the pnpm/turbo monorepo
# for Railway. Only the backend workspace is deployed here - the Nuxt/Next
# storefront is not part of this image and deploys separately (Vercel).
#
# The same image is used for both the API server and the background worker
# Railway service; which one a container runs is controlled entirely by the
# WORKER_MODE env var (shared | server | worker), read by medusa-config.ts.

FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@11.5.0 --activate
WORKDIR /repo

# ---- Build stage: needs the full monorepo (pnpm workspace resolution
# requires every workspace's package.json + the root lockfile), plus
# devDependencies to compile TypeScript and bundle the Admin dashboard.
FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter=@dtc/backend build

# ---- Production stage: only `apps/backend/.medusa/server`, the
# self-contained deployable Medusa produces (its own package.json,
# compiled src, compiled medusa-config.js, built Admin static assets).
# This is Medusa's own documented production artifact - see
# https://docs.medusajs.com/learn/production - not a shortcut invented
# here, and it intentionally carries no lockfile of its own.
FROM base AS production
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /repo/apps/backend/.medusa/server ./
# .medusa/server has no pnpm-workspace.yaml of its own, so pnpm has no
# allowBuilds allowlist here and refuses (hard error, not just a warning,
# on this pnpm version) to run native postinstall scripts for packages
# like sharp/esbuild - reuse the monorepo's own allowlist so the runtime
# native builds (sharp, esbuild, msgpackr-extract, protobufjs) actually run.
COPY --from=build /repo/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN pnpm install --prod

EXPOSE 9000

CMD ["pnpm", "start"]
