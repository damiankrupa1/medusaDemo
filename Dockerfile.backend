# syntax=docker/dockerfile:1
#
# Builds the Medusa backend (apps/backend) out of the pnpm/turbo monorepo
# for Railway. Only the backend workspace is deployed here - the Nuxt/Next
# storefront is not part of this image and deploys separately (Vercel).
#
# The same image is used for both the API server and the background worker
# Railway service; which one a container runs is controlled entirely by the
# WORKER_MODE env var (shared | server | worker), read by medusa-config.ts.
#
# Single stage, deliberately. This started as a multi-stage build (a
# `build` stage running `pnpm install` + `medusa build`, then a leaner
# `production` stage copying just `.medusa/server` + node_modules across
# the stage boundary). That approach worked reliably with a local
# `docker build`, but broke twice on Railway's own remote builder in ways
# a local build never reproduced:
#   1. A `COPY --from=build` split across three separate instructions
#      (node_modules, apps/backend/node_modules, .medusa/server) failed
#      with "failed to calculate checksum of ref ...: not found" for one
#      of the paths - reproducible even with NO_CACHE=1 set, so not a
#      stale/evicted cache issue.
#   2. Consolidating those into a single `COPY --from=build /repo /repo`
#      built successfully, but pnpm's node_modules symlinks (each
#      workspace's node_modules/<pkg> is a *relative* symlink into the
#      shared node_modules/.pnpm store) didn't survive the copy on
#      Railway's builder - the container crash-looped with
#      "Cannot find module '.../node_modules/@medusajs/cli/cli.js'",
#      even though the exact same image built and ran correctly locally.
#
# Two independent failures of the same mechanism (copying a large
# symlink-heavy directory tree across a build-stage boundary) on the
# same remote builder is enough signal to stop trying to make that
# mechanism work and remove it instead: everything happens in one stage,
# so node_modules is created and used in place, never copied anywhere.
# Larger image (ships devDependencies and the storefront workspace's own
# node_modules too) but there is no cross-stage copy left to break.
FROM node:22-slim
RUN corepack enable && corepack prepare pnpm@11.5.0 --activate
WORKDIR /repo

COPY . .

# Two env vars that only matter on Railway's builder - a local
# `docker build` produced a working image without either of them:
#
# NODE_ENV=development for the install step: Railway sets
# NODE_ENV=production in the build environment, which changes what pnpm
# links into the workspace. devDependencies are needed here regardless,
# since `medusa build` bundles the Admin dashboard with vite/typescript.
#
# NPM_CONFIG_NODE_LINKER=hoisted: pnpm's default layout is a symlink
# farm - each workspace's node_modules/<pkg> is a relative symlink into
# the shared node_modules/.pnpm store. On Railway that layout came out
# incomplete: a build log showed @medusajs/cli present in
# node_modules/.pnpm but *no* apps/backend/node_modules/@medusajs/cli
# symlink and no .bin/medusa either, so the container crash-looped on
# MODULE_NOT_FOUND. "hoisted" makes pnpm write a flat, npm-style
# node_modules of real directories instead, so there are no symlinks
# left to go missing.
ENV NODE_ENV=development
ENV NPM_CONFIG_NODE_LINKER=hoisted
RUN pnpm install --frozen-lockfile
RUN pnpm --filter=@dtc/backend build

RUN echo "=== MEDUSA BUILD ===" && \
    find /repo/apps/backend/.medusa/server -maxdepth 2 -type f | head -100

ENV NODE_ENV=production
WORKDIR /repo/apps/backend
EXPOSE 9000

CMD ["../../node_modules/.bin/medusa", "start"]